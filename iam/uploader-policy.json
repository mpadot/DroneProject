{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["flights/", "flights/*"]
        }
      }
    },
    {
      "Sid": "UploadAndVerifyFlightCsv",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET_NAME/flights/*"
    }
  ]
}
